# Short payment links -- /pay/<id> -> resolved from the payment_shortlinks
# table by netlify/functions/pay-redirect.js (302 redirect to the real Stripe
# Checkout URL). Created by visito-create-reservation.js so Lana can hand a
# guest a short link instead of Stripe's ~600-char Checkout URL.
/pay/:id  /.netlify/functions/pay-redirect/:id  200

# Short teacher-view links -- /nombredellider -> resolved live from Supabase
# by netlify/functions/shortlink.js (302 redirect to booking-hub.html?mode=teacher&bk=...).
# Only applies to paths that don't match a real file (booking-hub.html, /js/*, images, etc.
# keep working normally) -- see shortlink.js for the slug/disambiguation rules.
# Guest booking page link -- /retreat-booking.html/<name> (name set in We Take Payment). Must sit above the catch-alls below.
/retreat-booking.html/:slug  /.netlify/functions/shortlink/:slug  200!

/:slug  /.netlify/functions/shortlink/:slug  200

# Section links for a teacher -- /nombredellider/dashboard, /schedule, /roomlist,
# /transport, /finances. Same lookup as the short link above; the function adds
# &view=<section> to the teacher URL so the portal opens straight on that tab.
/:slug/:view  /.netlify/functions/shortlink/:slug  200
