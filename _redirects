# Spa-only staff link (Rosy/Kike/Host/Rubi etc.) -- redirects to booking-hub.html
# in spa-staff mode (own login, no access to the rest of the portal). Must be
# a real redirect (302), not a 200 rewrite -- a rewrite keeps the URL bar as
# /spa-staff with no query string, so the page's JS never sees ?mode=spa-staff
# and falls through to the main admin login instead. Must also come before
# the catch-all shortlink rule below so it isn't swallowed by it.
/spa-staff  /booking-hub.html?mode=spa-staff  302

# Short teacher-view links -- /nombredellider -> resolved live from Supabase
# by netlify/functions/shortlink.js (302 redirect to booking-hub.html?mode=teacher&bk=...).
# Only applies to paths that don't match a real file (booking-hub.html, /js/*, images, etc.
# keep working normally) -- see shortlink.js for the slug/disambiguation rules.
/:slug  /.netlify/functions/shortlink/:slug  200
